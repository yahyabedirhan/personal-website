---
// Every page's document: the head from src/meta.js, the theme set before first paint, the fonts,
// the client router that moves between pages without a full load, and the background element #bg,
// where src/main.js draws the topographic library's canvas. #bg persists across the router's page
// changes, so the background keeps running and morphs to the next page's state; bg is that state
// (0 idle, 1-4 a project, 5 kudos, see bgScenes in data.js).
import { ClientRouter } from 'astro:transitions';
import { absolute } from '../meta.js';
import '../style.css';
// page is an entry from src/meta.js
const { page, bg = 0 } = Astro.props;
const url = page.path ? absolute(page.path) : null;
const image = absolute(page.image);
---
<!doctype html>
<html lang="en" data-theme="dark" transition:animate="none">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>{page.title}</title>
<meta name="description" content={page.description}>
{url && <link rel="canonical" href={url}>}
{!url && <meta name="robots" content="noindex">}
<link rel="icon" type="image/png" sizes="32x32" href="/favicon.png">
<link rel="apple-touch-icon" href="/apple-touch-icon.png">
<link rel="sitemap" href="/sitemap.xml">
<meta name="theme-color" content="#0b0b0d">
<meta property="og:type" content="website">
{url && <meta property="og:url" content={url}>}
<meta property="og:title" content={page.title}>
<meta property="og:description" content={page.ogDescription || page.description}>
<meta property="og:image" content={image}>
<meta name="twitter:card" content={page.card}>
<meta name="color-scheme" content="dark light">
<!-- dark for everyone; light only when chosen in the footer. Runs before paint, so no flash. -->
<script is:inline>try{if(localStorage.getItem('theme')==='light')document.documentElement.dataset.theme='light'}catch(e){}</script>
<link rel="preconnect" href="https://fonts.googleapis.com"><link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500&family=Literata:opsz,wght@7..72,600&display=swap" rel="stylesheet">
<ClientRouter fallback="animate" />
</head>
<body>
<div id="bg" aria-hidden="true" transition:persist="bg"></div>
<div id="app" data-bg={bg}><slot /></div>
<script>
  import '../main.js';
</script>
</body>
</html>

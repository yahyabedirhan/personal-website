// Cloudflare Workers deploy: serve the Vite build as static assets.
// single-page-application sends unknown paths like /projects/havooch to index.html.
{
  "name": "personal-website",
  "compatibility_date": "2026-09-01",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  },
  // turned on in the dashboard; kept here so a deploy doesn't turn it off
  "observability": {
    "logs": {
      "enabled": true,
      "invocation_logs": true,
      "persist": true
    }
  }
}
